# ==============================================================================
# Autonomous University & College Query Assistant — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to GitHub!

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase pgvector Configuration (Get from https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin Portal Access Password (Customizable)
ADMIN_PASSWORD=admin123

# Local Development Server Port
PORT=3000
